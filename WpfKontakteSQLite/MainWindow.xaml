<Window x:Class="WpfKontakteSQLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfKontakteSQLite"
        mc:Ignorable="d"
        Title="Contacts - Main Menu" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="lstBox1" HorizontalAlignment="Left" Height="222" VerticalAlignment="Top" Width="364" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="220,108,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding Telefon}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="btnFind" Content="Find" HorizontalAlignment="Left" Height="50" Margin="484,33,0,0" VerticalAlignment="Top" Width="100" Click="btnFind_Click"/>
        <Button x:Name="btnAdd" Content="Add" HorizontalAlignment="Left" Height="50" Margin="220,350,0,0" VerticalAlignment="Top" Width="100" Click="btnAdd_Click"/>
        <Button x:Name="btnEdit" Content="Edit" HorizontalAlignment="Left" Height="50" Margin="352,350,0,0" VerticalAlignment="Top" Width="100" Click="btnEdit_Click"/>
        <Button x:Name="btnDelete" Content="Delete" HorizontalAlignment="Left" Height="50" Margin="484,350,0,0" VerticalAlignment="Top" Width="100" Click="btnDelete_Click"/>

        <TextBox x:Name="tbFind" HorizontalAlignment="Left" Height="24" Margin="220,46,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="259" KeyUp="btnFind_Click"/>


    </Grid>
</Window>
