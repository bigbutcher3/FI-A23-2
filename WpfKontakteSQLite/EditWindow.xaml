<Window x:Class="WpfKontakteSQLite.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfKontakteSQLite"
        mc:Ignorable="d"
        Title="EditWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Name" HorizontalAlignment="Left" Margin="53,116,0,0" VerticalAlignment="Top"/>
        <Label Content="Telefon" HorizontalAlignment="Left" Margin="53,180,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbName" HorizontalAlignment="Left" Height="40" Margin="130,116,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="311"/>
        <TextBox x:Name="tbTelefon" HorizontalAlignment="Left" Height="40
                 " Margin="130,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="311"/>
        <Label x:Name="lblHeadline" Content="Contact" HorizontalAlignment="Left" Margin="53,10,0,0" VerticalAlignment="Top" FontSize="36"/>
        <Button x:Name="btnSave" Content="Save" HorizontalAlignment="Left" Height="50" Margin="130,279,0,0" 
                VerticalAlignment="Top" Width="109" Click="btnSave_Click"/>
        <Button x:Name="btnCancel" Content="Cancel" HorizontalAlignment="Left" Height="50" Margin="332,279,0,0" 
                VerticalAlignment="Top" Width="109" Click="btnCancel_Click"/>

    </Grid>
</Window>
