<Window x:Class="WpfApp_DataGrid_List.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_DataGrid_List"
        mc:Ignorable="d"
        Title="Telefonbuch - Übersicht" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dg1" ItemsSource="{Binding list}" AutoGenerateColumns="False" Margin="10,80,10,139">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding DbId}"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnAdd" Content="Add" HorizontalAlignment="Left"
            Margin="110,350,0,0" VerticalAlignment="Top" Height="50" Width="100"
            Click="btnAdd_Click" />
        <Button x:Name="btnDelete" Content="Delete" HorizontalAlignment="Left"
            Height="50" Margin="600,350,0,0" VerticalAlignment="Top" Width="100"
            Click="btnDelete_Click" />
        <TextBox HorizontalAlignment="Left" Height="20" Margin="10,20,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="585" Name="txtBoxSearch"/>
        <TextBlock IsHitTestVisible="False" Text="Enter Search Term Here" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="13,22,0,0" Foreground="DarkGray">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=txtBoxSearch}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button Content="Search" HorizontalAlignment="Left" Height="23" Margin="600,20,0,0" VerticalAlignment="Top" Width="100" Name="btnSearch" Click="btnSearch_Click"/>
        <Button x:Name="btnEdit" Content="Edit" HorizontalAlignment="Center"
            Height="50" Margin="0,350,0,0" VerticalAlignment="Top" Width="100"
            Click="btnEdit_Click" />
    </Grid>

</Window>
