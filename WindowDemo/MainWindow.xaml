<Window x:Class="WindowDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid HorizontalAlignment="Center" Height="207" Margin="0,10,0,0" VerticalAlignment="Top" Width="780" x:Name="dg1" d:ItemsSource="{d:SampleData ItemCount=5}" ItemsSource="{Binding Items}" AutoGenerateColumns="True"/>
        <Button Content="Add" HorizontalAlignment="Left" Height="50" Margin="100,300,0,0" VerticalAlignment="Top" Width="100" Name="btnAdd" Click="btnAdd_Click"/>
        <Button Content="Delete" HorizontalAlignment="Left" Height="50" Margin="600,300,0,0" VerticalAlignment="Top" Width="100" Name="btnDelete" Click="btnDelete_Click"/>
    </Grid>
</Window>
